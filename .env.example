# Google Sheets: либо JSON одной строкой (Railway), либо файл (локально)
GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}
GOOGLE_SERVICE_ACCOUNT_FILE=google_credentials.json
GOOGLE_SPREADSHEET_KEY=your_spreadsheet_id_here

# Публичный URL сервиса для отдачи фото (на Railway подставляется автоматически)
PUBLIC_BASE_URL=https://your-app.up.railway.app

# Tilda MCP (Профиль -> Ключи MCP), project Ren.flowers
