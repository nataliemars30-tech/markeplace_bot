# Telegram Bot (обязательно)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_ALLOWED_IDS=123456789,987654321

# Flowwow API
FLOWWOW_TOKEN=your_flowwow_bearer_token_here
FLOWWOW_SHOP_ID=222976

# МойСклад API
MOYSKLAD_TOKEN=your_moysklad_bearer_token_here

# Яндекс Диск API (OAuth)
YANDEX_DISK_TOKEN=y0_AgAAAA...

# Google Sheets: либо JSON одной строкой (Railway), либо файл (локально)
GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}
GOOGLE_SERVICE_ACCOUNT_FILE=google_credentials.json
GOOGLE_SPREADSHEET_KEY=your_spreadsheet_id_here
